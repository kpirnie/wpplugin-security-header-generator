msgid "Understanding CSP Directive Configuration"
msgstr ""

#: work/doc.php:408
msgid "Each CSP directive (like script-src, style-src, etc.) has two configuration sections:"
msgstr ""

#: work/doc.php:410
msgid "Source Field (Left Side):"
msgstr ""

#: work/doc.php:412
msgid "Enter external domains that should be allowed for this type of resource"
msgstr ""

#: work/doc.php:413
msgid "Example for scripts: <code>cdn.jsdelivr.net ajax.googleapis.com</code>"
msgstr ""

#: work/doc.php:414
msgid "Separate multiple domains with spaces"
msgstr ""

#: work/doc.php:418
msgid "Extra Settings Checkboxes (Right Side):"
msgstr ""

#: work/doc.php:420
msgid "Allow resources from your own domain (recommended for most directives)"
msgstr ""

#: work/doc.php:421
msgid "Allow inline styles/scripts embedded in your HTML. <strong>Warning:</strong> This reduces security and should only be used if necessary."
msgstr ""

#: work/doc.php:422
msgid "Allow JavaScript eval() function. <strong>Warning:</strong> This reduces security and should only be used if necessary."
msgstr ""

#: work/doc.php:423
msgid "Allow hashes in the source list to also match inline event handlers and <code>style</code> attributes. Script and style directives only."
